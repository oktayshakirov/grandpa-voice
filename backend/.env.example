# Your permanent OpenAI key. Stays on the server only.
OPENAI_API_KEY=sk-...

# One long random token per phone, comma-separated. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DEVICE_TOKENS=replace-with-a-long-random-token

# Optional
REALTIME_MODEL=gpt-realtime-1.5
# Models a phone may pick in its settings (comma-separated)
ALLOWED_MODELS=gpt-realtime-1.5,gpt-realtime-2.1-mini
MAX_SESSIONS_PER_HOUR=20
PORT=8787
